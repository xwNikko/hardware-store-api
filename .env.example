# Copia este archivo como ".env" y ajusta los valores a tu instalación

# El nombre del servidor que ves en SSMS al conectarte, por ejemplo:
# localhost\SQLEXPRESS  o  LAPTOP-R3J1K349\NIKKO...
DB_SERVER=localhost\SQLEXPRESS

DB_DATABASE=Ferreteria

# yes = usar tu usuario de Windows (igual que en SSMS). Recomendado para desarrollo local.
DB_TRUSTED_CONNECTION=yes

# Solo se usan si DB_TRUSTED_CONNECTION=no
DB_USER=
DB_PASSWORD=

# Cambia esto por cualquier texto largo y aleatorio (sirve para proteger las sesiones de login)
SECRET_KEY=cambia-esta-clave-por-un-texto-largo-y-aleatorio
